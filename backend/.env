# ══════════════════════════════════════════════════
# AUTOMARKET BACKEND — Variables de Entorno
# ══════════════════════════════════════════════════
# Archivo: backend/.env
# USO LOCAL: renombra a .env y pega tus valores
# USO CLOUD RUN: pega cada KEY=VALUE en la consola
#   GCP Console → Cloud Run → automarket-api
#   → Editar → Variables de entorno → Agregar

# ──────────────────────────────────────────────────
# 🤖 GEMINI AI — REQUERIDO para activar Axel real
# Obtén tu key en: https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────────
GEMINI_API_KEY=

# ──────────────────────────────────────────────────
# 🔥 GOOGLE CLOUD PROJECT
# Tu project ID de GCP (ya configurado en Cloud Run)
# ──────────────────────────────────────────────────
GCP_PROJECT_ID=vive-libre-app-2026

# ──────────────────────────────────────────────────
# 🪣 FIREBASE STORAGE BUCKET
# Lo encuentras en: Firebase Console → Storage → gs://...
# Formato: mi-proyecto.appspot.com  (sin gs://)
# ──────────────────────────────────────────────────
STORAGE_BUCKET=vive-libre-app-2026.appspot.com

# ──────────────────────────────────────────────────
# 🌐 URL FRONTEND (para CORS)
# ──────────────────────────────────────────────────
FRONTEND_URL=https://automarket-ym4fl5dx5q-uc.a.run.app

# ──────────────────────────────────────────────────
# 📧 EMAIL NOTIFICATIONS — OPCIONAL
# Usa una cuenta Gmail con "App Password" habilitado
# Google Account → Seguridad → Contraseñas de aplicación
# ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=

# ──────────────────────────────────────────────────
# 🚪 PUERTO (Cloud Run lo setea automáticamente)
# ──────────────────────────────────────────────────
PORT=8080
